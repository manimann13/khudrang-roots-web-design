!/assets/fonts/Spectral-latin-ext-normal-400.woff2
!/assets/fonts/Spectral-latin-ext-normal-500.woff2
!/assets/fonts/Spectral-latin-italic-400.woff2
!/assets/fonts/Spectral-latin-normal-400.woff2
!/assets/fonts/Spectral-latin-normal-500.woff2
!/assets/images/
/assets/images/*
!/assets/images/partner-logos/
/assets/images/partner-logos/*
!/assets/images/partner-logos/logo-ghk.webp
!/assets/images/partner-logos/logo-khalsa-aid.webp
