# Allowlist: ignore everything, then let in only what the live page needs.
# Original photos, other assets, drafts, notes and local tooling all stay on this machine.
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html

# the page: design/directions/final + the two shared files it loads
!/design/
/design/*
!/design/directions/
/design/directions/*
!/design/directions/final/
/design/directions/final/*
!/design/directions/final/index.html
!/design/directions/final/styles.css
!/design/directions/final/main.js
!/design/directions/r5-shared/
/design/directions/r5-shared/*
!/design/directions/r5-shared/base.css
!/design/directions/r5-shared/base.js

# only the web-sized images and fonts the page displays
!/assets/
/assets/*
!/assets/brand/
/assets/brand/*
!/assets/brand/khudrang-roots-cursive.png
!/assets/brand/khudrangrootslogo.png
!/assets/fonts/
/assets/fonts/*
!/assets/fonts/fonts-local.css
!/assets/fonts/AnekGurmukhi-gurmukhi-normal-300-800.woff2
!/assets/fonts/AnekGurmukhi-latin-ext-normal-300-800.woff2
!/assets/fonts/AnekGurmukhi-latin-normal-300-800.woff2
!/assets/fonts/BricolageGrotesque-latin-ext-normal-300-800.woff2
!/assets/fonts/BricolageGrotesque-latin-normal-300-800.woff2
